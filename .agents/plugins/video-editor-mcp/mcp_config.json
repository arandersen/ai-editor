{
  "mcpServers": {
    "free-audio": {
      "command": "bash",
      "args": [
        "./scripts/mcp_server.sh",
        "free-audio"
      ]
    },
    "flow": {
      "command": "bash",
      "args": [
        "./scripts/mcp_server.sh",
        "flow"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "--yes",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
