{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Talking Head EDL v1",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "raw_video",
    "resolution",
    "fps",
    "segments",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "raw_video": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 64,
        "multipleOf": 2
      }
    },
    "fps": {
      "type": "number",
      "minimum": 1,
      "maximum": 120
    },
    "approval": {
      "type": "object",
      "required": [
        "plan_hash",
        "approved_by"
      ],
      "properties": {
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "speed": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 16
          },
          "zoom": {
            "type": "number",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ]
      }
    }
  },
  "description": "editor.core.validate adds capability, approval-hash, interval, asset and semantic checks. JSON Schema alone is not sufficient."
}
